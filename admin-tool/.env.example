# DB 接続先 (既定値は docker-compose のローカル MySQL)
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=4306
NUXT_DB_USER=howlingwolfuser
NUXT_DB_PASSWORD=howlingwolfpass
NUXT_DB_NAME=howlingwolfdb

# Firebase Admin SDK サービスアカウント JSON のパス (任意)
# 未設定の場合、Google / Twitter アカウント情報は「未設定」と表示される
NUXT_FIREBASE_SERVICE_ACCOUNT_PATH=
